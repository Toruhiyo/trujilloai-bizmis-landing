# Generated lead data (source of truth is bizmis-skills/data/invite-cards/).
# The loader in src/data/leads/index.ts auto-discovers any JSONs that exist
# locally via import.meta.glob, so production builds still work when these
# files are absent (e.g. on Vercel, where bizmis-skills is not checked out).
src/data/leads/*.json

# Local invite-card asset mirror. Production serves /invite-cards/* from
# Vercel Blob Storage (see vercel.json rewrites); devs typically symlink
# this to ../../bizmis-skills/data/invite-cards for local previews.
public/invite-cards

# Frame-accurate ad-1 exports (PNG sequence, video, markers).
tmp/ad-1-export*

# Env files
.env
.env.local
.env.development
.env.production

