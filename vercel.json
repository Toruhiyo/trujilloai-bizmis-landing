{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:locale(es|fr|it|ca)/:page(privacy|terms)",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/join-waitlist",
      "destination": "/early-access",
      "permanent": true
    },
    {
      "source": "/:locale(es|fr|it|ca)/join-waitlist",
      "destination": "/:locale/early-access",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/api/demo"
    },
    {
      "source": "/invite-cards/:path*",
      "destination": "https://go.bizmis.ai/invite-cards/:path*"
    },
    {
      "source": "/:locale(es|fr|it|ca)",
      "destination": "/:locale/index.html"
    },
    {
      "source": "/:page(pricing|faqs|contact|early-access|privacy|terms|v1)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/:locale(es|fr|it|ca)/:page(pricing|faqs|contact|early-access|v1)",
      "destination": "/:locale/:page/index.html"
    },
    {
      "source": "/:locale(es|fr|it|ca)?/:page(v2|unsubscribe)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/:area(admin|email-renders)/:path*",
      "destination": "/app-shell.html"
    }
  ]
}
